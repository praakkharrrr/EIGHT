# =====================================================================
# EIGHT — AI Crash-Test Lab Environment Configuration
# Copy this file to .env and insert your real Gemini API key.
# Never commit your actual .env file to version control.
# =====================================================================

# Google Gemini / Gemma API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma Model Identifier (Defaults to gemma-4 or gemma-2-27b-it / gemini-2.5-flash)
GEMMA_MODEL=gemma-4

# Generation Hyperparameters
GEMMA_TIMEOUT=30.0
GEMMA_MAX_TOKENS=2048
GEMMA_TEMPERATURE=0.2
